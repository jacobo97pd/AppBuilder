# Servidor local de un solo usuario. Nunca subas este archivo con secretos a Git.
PORT=4310
HOST=127.0.0.1
# Obligatorio para acceso remoto. Usa un valor aleatorio largo y HTTPS.
# APPBUILDER_ACCESS_TOKEN=
# APPBUILDER_PUBLIC_ORIGIN=https://studio.example.com
# APPBUILDER_DATA_DIR=
# Credenciales opcionales; también puedes configurarlas en Conexiones.
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# CODEMAGIC_API_TOKEN=
# APPLE_ISSUER_ID=
# APPLE_KEY_ID=
# APPLE_PRIVATE_KEY=
# GOOGLE_SERVICE_ACCOUNT_JSON=
# GITHUB_TOKEN=
# Clave maestra opcional: 32 bytes aleatorios en base64, fuera del directorio de datos.
# APPBUILDER_VAULT_KEY=
# APPBUILDER_SERVER_URL=https://studio.example.com
# VITE_APPBUILDER_SERVER_URL=https://studio.example.com
